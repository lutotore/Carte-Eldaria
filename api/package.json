{
  "name": "eldaria-api",
  "private": true,
  "version": "1.0.0",
  "description": "API du portail de campagne d'Eldaria : comptes, invitations, état du monde.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/serveur.js",
    "dev": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --watch src/serveur.js",
    "cli": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/cli.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/rate-limit": "^10.3.0",
    "fastify": "^5.12.5"
  },
  "devDependencies": {
    "vitest": "^5.0.2"
  }
}
